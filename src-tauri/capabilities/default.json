{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema.json",
  "identifier": "default",
  "description": "TerminalX default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:webview:default",
    {
      "identifier": "fs:default",
      "allow": [{ "path": "$APPDATA/**" }, { "path": "$APPCONFIG/**" }, { "path": "$APPLOCALDATA/**" }, { "path": "$DOCUMENT/**" }, { "path": "$DESKTOP/**" }, { "path": "$HOME/Projects/**" }],
      "deny": [{ "path": "$APPCONFIG/**/.env" }, { "path": "$HOME/.ssh/**" }, { "path": "$HOME/.aws/**" }, { "path": "$HOME/.config/gcloud/**" }]
    },
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-write-file",
    "window-state:default",
    "notification:default",
    "notification:allow-notify",
    "global-shortcut:default",
    "global-shortcut:allow-register",
    "dialog:default"
  ]
}
